# 部署环境变量模板：复制为 .env 后填入真实值（docker-compose 自动读取同目录 .env）

# 后端 JWT 密钥（必填，建议 32+ 位随机字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 豆包 AI 服务（必填 DOUBAO_API_KEY）
DOUBAO_API_KEY=your-doubao-api-key-here
DOUBAO_MODEL=doubao-seed-2-1-pro-260628
DOUBAO_TIMEOUT=600

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=qinkangzhijian

# 允许跨域的来源（逗号分隔；原生 App 不受影响，Expo Web/网页才需要）
ALLOWED_ORIGINS=*
