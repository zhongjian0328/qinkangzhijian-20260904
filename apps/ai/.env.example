# 豆包（火山方舟）API 配置
DOUBAO_API_KEY=your-doubao-api-key-here

# 模型选择：当前默认 pro 多模态版（已关闭思维链，诊断约 12s）。
# 如需更快/更省，可在火山方舟控制台开通以下任一模型后替换：
#   doubao-seed-2-1-turbo-260628  （涡轮版，更快）
#   doubao-seed-2-0-lite-260428   （轻量版）
#   doubao-seed-2-0-mini-260428   （迷你版，最快最省）
DOUBAO_MODEL=doubao-seed-2-1-pro-260628

# 推理超时（秒）：诊断含 42 章知识库注入 + 多图，给足余量
DOUBAO_TIMEOUT=600
PORT=5000
