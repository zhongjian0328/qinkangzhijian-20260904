# 豆包（火山方舟）API 配置
DOUBAO_API_KEY=your-doubao-api-key-here

# 模型选择：默认 turbo 多模态版（与 pro 同族，已关闭思维链，实测更快）。
# 图像诊断必须用支持图片输入的模型，可选：
#   doubao-seed-2-1-turbo-260628  （涡轮版，推荐，已实测支持图片）
#   doubao-seed-2-0-lite-260428   （轻量版，已实测支持图片，更省）
# 注意：DeepSeek-V4-Flash / GLM-5.2 为纯文本模型，不支持图片输入，不能用于图像诊断。
DOUBAO_MODEL=doubao-seed-2-1-turbo-260628

# 推理超时（秒）：诊断含 42 章知识库注入 + 多图，给足余量
DOUBAO_TIMEOUT=600
PORT=5000
