// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  phone     String   @unique
  email     String?  @unique
  password  String
  role      Role     @default(farmer)
  subRole   String?  // small | cooperative | enterprise | service | medicine | equipment | cdc | research | teacher | learning | cognitive | internship
  avatar    String?
  farmId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diagnoses       Diagnosis[]
  poultryHouse    PoultryHouse[]
  batches         Batch[]
  preventionPlans PreventionPlan[]
  environmentTests EnvironmentTest[]
  epidemicRecords  EpidemicRecord[]
  orders           Order[]
  serviceOrders    ServiceOrder[]
  consultations    Consultation[]
  examRecords      ExamRecord[]
  internLogs       InternLog[]
  certification    Certification?
  notifications    Notification[]

  @@map("users")
}

model PoultryHouse {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  capacity    Int
  currentCount Int    @default(0)
  species     Species
  age         Int      // days
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  environmentData EnvironmentData[]
  alerts        Alert[]
  batches       Batch[]
  environmentTests EnvironmentTest[]

  @@map("poultry_houses")
}

model EnvironmentData {
  id          String   @id @default(uuid())
  houseId     String
  house       PoultryHouse @relation(fields: [houseId], references: [id])
  temperature Float
  humidity    Float
  ammonia     Float?
  co2         Float?
  ventilation Ventilation
  timestamp   DateTime @default(now())

  @@index([houseId, timestamp])
  @@map("environment_data")
}

model EnvironmentTest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId   String?
  house     PoultryHouse? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  category  EnvironmentCategory // air | water | feed | surface
  metrics   Json     // 各类型检测指标（键值对，如 { ph: 7.2, bacteria: 500 }）
  result    EnvironmentResult @default(normal)
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, category, createdAt])
  @@map("environment_tests")
}

model EpidemicRecord {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location      String   // 详细地址
  province      String?
  city          String?
  district      String?
  disease       String   // 疑似疾病
  affectedCount Int      // 发病数量
  deathCount    Int      @default(0) // 死亡数量
  symptoms      String?  // 主要症状
  level         EpidemicLevel @default(suspected)
  reportedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([province, city, district])
  @@map("epidemic_records")
}

model Diagnosis {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  imageUrls     String[]      @default([])
  species       Species
  symptoms      String[]
  aiResult      Json          // AIResult object
  confidence    Float
  status        DiagnosisStatus @default(pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  preventionPlan PreventionPlan?

  @@index([userId, createdAt])
  @@map("diagnoses")
}

model Alert {
  id            String      @id @default(uuid())
  houseId       String
  house         PoultryHouse @relation(fields: [houseId], references: [id])
  type          AlertType
  severity      Severity
  message       String
  acknowledged  Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([houseId, createdAt])
  @@map("alerts")
}

model AIModelVersion {
  id          String   @id @default(uuid())
  name        String   @unique
  version     String
  modelPath   String
  accuracy    Float
  isActive    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  @@map("ai_model_versions")
}

model Batch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId   String?
  house     PoultryHouse? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  batchNo   String
  breed     String
  quantity  Int
  startDate DateTime
  status    BatchStatus @default(active)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyRecords DailyRecord[]

  @@index([userId, createdAt])
  @@map("batches")
}

model DailyRecord {
  id          String   @id @default(uuid())
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recordDate  DateTime
  deathCount  Int      @default(0)
  cullCount   Int      @default(0)
  feedAmount  Float    @default(0)
  waterAmount Float    @default(0)
  eggCount    Int      @default(0)
  temperature Float?
  humidity    Float?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([batchId, recordDate])
  @@map("daily_records")
}

model PreventionPlan {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosisId String   @unique
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  content     Json     // 结构化预案（诊断结论/紧急处置/绿色用药/免疫/生物安全/监测/回访要点）
  status      PreventionStatus @default(active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  followUps FollowUp[]

  @@index([userId, createdAt])
  @@map("prevention_plans")
}

model FollowUp {
  id          String   @id @default(uuid())
  planId      String
  plan        PreventionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOffset   Int      // 3 或 7 日回访
  status      FollowUpStatus @default(pending)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([planId, createdAt])
  @@map("follow_ups")
}

model Product {
  id           String   @id @default(uuid())
  name         String
  category     String
  price        Float
  stock        Int      @default(0)
  unit         String
  description  String?
  image        String?
  manufacturer String?
  createdAt    DateTime @default(now())

  @@map("products")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       Json        // [{productId, name, price, quantity}]
  totalAmount Float
  status      OrderStatus @default(pending)
  address     String?
  phone       String?
  createdAt   DateTime    @default(now())

  @@index([userId, createdAt])
  @@map("orders")
}

model ServiceOrder {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType   ServiceType
  description   String?
  address       String?
  appointmentAt DateTime?
  status        ServiceOrderStatus @default(pending)
  vetId         String?
  price         Float?
  createdAt     DateTime          @default(now())

  @@index([userId, createdAt])
  @@map("service_orders")
}

model Consultation {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vetId     String?
  subject   String
  messages  Json               // [{role, content, timestamp}]
  status    ConsultationStatus @default(active)
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("consultations")
}

model Question {
  id          String       @id @default(uuid())
  type        QuestionType
  chapter     String?
  difficulty  Difficulty   @default(medium)
  question    String
  options     String       // JSON 数组
  answer      String       // JSON 数组（正确选项下标）
  explanation String?
  createdAt   DateTime     @default(now())

  @@map("questions")
}

model ExamRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ExamType @default(practice)
  chapter    String?
  totalScore Int
  score      Int
  answers    String   // JSON
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("exam_records")
}

model InternLog {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  content          String
  images           String?         // JSON 数组（图片 URL）
  studentDiagnosis String?
  mentorComment    String?
  mentorId         String?
  status           InternLogStatus @default(submitted)
  logDate          DateTime
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([status, logDate])
  @@map("intern_logs")
}

model Certification {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         CertificationType
  data         Json                // 认证表单字段（按类型）
  images       String[]            @default([]) // 资质证件图片 URL
  status       CertificationStatus @default(pending)
  reviewerNote String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@map("certifications")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  content   String
  data      Json?            // 关联跳转信息（如 { diagnosisId, orderId }）
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

enum Role {
  admin
  farmer
  vet
  technician
  merchant
  institution
  student
}

enum Species {
  chicken
  duck
  goose
  turkey
  other
}

enum Ventilation {
  good
  moderate
  poor
}

enum DiagnosisStatus {
  pending
  analyzing
  completed
  failed
}

enum BatchStatus {
  active
  completed
  archived
}

enum PreventionStatus {
  active
  completed
  archived
}

enum FollowUpStatus {
  pending
  completed
}

enum AlertType {
  temperature
  humidity
  ammonia
  co2
  disease
}

enum Severity {
  warning
  critical
}

enum EnvironmentCategory {
  air
  water
  feed
  surface
}

enum EnvironmentResult {
  normal
  warning
  abnormal
}

enum EpidemicLevel {
  suspected
  confirmed
  controlled
}

enum OrderStatus {
  pending
  paid
  shipped
  completed
  cancelled
}

enum ServiceType {
  on_site
  online
  lab_test
}

enum ServiceOrderStatus {
  pending
  accepted
  in_progress
  completed
  cancelled
}

enum ConsultationStatus {
  active
  closed
}

enum QuestionType {
  single
  multiple
  judge
}

enum Difficulty {
  easy
  medium
  hard
}

enum ExamType {
  practice
  mock
}

enum InternLogStatus {
  submitted
  reviewed
}

enum CertificationType {
  farmer
  vet
  merchant
  institution
  student
}

enum CertificationStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  warning
  diagnosis
  policy
  order
  teaching
  system
}
