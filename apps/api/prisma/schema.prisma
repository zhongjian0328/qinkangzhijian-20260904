// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  phone     String   @unique
  email     String?  @unique
  password  String
  role      Role     @default(farmer)
  subRole   String?  // small | cooperative | enterprise | service | medicine | equipment | cdc | research | teacher | learning | cognitive | internship
  avatar    String?
  farmId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  diagnoses       Diagnosis[]
  poultryHouse    PoultryHouse[]
  batches         Batch[]
  preventionPlans PreventionPlan[]
  environmentTests EnvironmentTest[]
  epidemicRecords  EpidemicRecord[]
  orders           Order[]
  serviceOrders    ServiceOrder[]
  consultations    Consultation[]
  examRecords      ExamRecord[]
  internLogs       InternLog[]
  certification    Certification?
  notifications    Notification[]
  products         Product[]      @relation("MerchantProducts")
  bids             Bid[]          @relation("MerchantBids")
  bulkPurchases    BulkPurchase[]
  consultSessions  ConsultSession[]
  policies          Policy[]
  policyReads       PolicyRead[]
  annotations       Annotation[]
  collaborations    Collaboration[]  @relation("CollabOwner")
  collabMessages    CollabMessage[]  @relation("CollabMessageUser")
  customers         Customer[]       @relation("CustomerOwner")
  immunizations     Immunization[]
  epidemicAlerts    EpidemicAlert[]
  epidemiologies    Epidemiology[]
  courses           Course[]         @relation("TeacherCourses")
  courseProgresses  CourseProgress[] @relation("StudentProgress")
  examPapers        ExamPaper[]      @relation("TeacherPapers")
  vetCases          VetCase[]

  @@map("users")
}

model PoultryHouse {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  capacity    Int
  currentCount Int    @default(0)
  species     Species
  age         Int      // days
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  environmentData EnvironmentData[]
  alerts        Alert[]
  batches       Batch[]
  environmentTests EnvironmentTest[]
  immunizations Immunization[]

  @@map("poultry_houses")
}

model EnvironmentData {
  id          String   @id @default(uuid())
  houseId     String
  house       PoultryHouse @relation(fields: [houseId], references: [id])
  temperature Float
  humidity    Float
  ammonia     Float?
  co2         Float?
  ventilation Ventilation
  timestamp   DateTime @default(now())

  @@index([houseId, timestamp])
  @@map("environment_data")
}

model EnvironmentTest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId   String?
  house     PoultryHouse? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  category  EnvironmentCategory // air | water | feed | surface
  metrics   Json     // 各类型检测指标（键值对，如 { ph: 7.2, bacteria: 500 }）
  result    EnvironmentResult @default(normal)
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, category, createdAt])
  @@map("environment_tests")
}

model EpidemicRecord {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location      String   // 详细地址
  province      String?
  city          String?
  district      String?
  disease       String   // 疑似疾病
  affectedCount Int      // 发病数量
  deathCount    Int      @default(0) // 死亡数量
  symptoms      String?  // 主要症状
  level         EpidemicLevel @default(suspected)
  reportedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([province, city, district])
  @@map("epidemic_records")
}

model Diagnosis {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  imageUrls     String[]      @default([])
  species       Species
  symptoms      String[]
  aiResult      Json          // AIResult object
  confidence    Float
  status        DiagnosisStatus @default(pending)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  preventionPlan PreventionPlan?

  @@index([userId, createdAt])
  @@map("diagnoses")
}

model VetCase {
  id                 String   @id @default(uuid())
  caseNo             String   @unique
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  status             String   @default("draft") // draft/submitted/analyzing/completed/failed/offline
  species            String   @default("chicken")

  // 9 大维度结构化信息（JSON）
  basicInfo          Json?
  chiefComplaint     Json?
  clinicalSymptoms   Json?
  necropsyLesions    Json?
  labTests           Json?
  immuneHistory      Json?
  medicationHistory  Json?
  environment        Json?
  epidemiology       Json?

  imageUrls          String[] @default([])

  // 诊断结果
  diagnosisResult    Json?
  diagnosisEngine    String?   // doubao_2_1_turbo / offline_rule
  confidence         Float?
  feedback           String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("vet_cases")
}

model Alert {
  id            String      @id @default(uuid())
  houseId       String
  house         PoultryHouse @relation(fields: [houseId], references: [id])
  type          AlertType
  severity      Severity
  message       String
  acknowledged  Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@index([houseId, createdAt])
  @@map("alerts")
}

model AIModelVersion {
  id          String   @id @default(uuid())
  name        String   @unique
  version     String
  modelPath   String
  accuracy    Float
  isActive    Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  @@map("ai_model_versions")
}

model Batch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId   String?
  house     PoultryHouse? @relation(fields: [houseId], references: [id], onDelete: SetNull)
  batchNo   String
  breed     String
  quantity  Int
  startDate DateTime
  status    BatchStatus @default(active)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyRecords DailyRecord[]
  immunizations Immunization[]

  @@index([userId, createdAt])
  @@map("batches")
}

model DailyRecord {
  id          String   @id @default(uuid())
  batchId     String
  batch       Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recordDate  DateTime
  deathCount  Int      @default(0)
  cullCount   Int      @default(0)
  feedAmount  Float    @default(0)
  waterAmount Float    @default(0)
  eggCount    Int      @default(0)
  temperature Float?
  humidity    Float?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([batchId, recordDate])
  @@map("daily_records")
}

model PreventionPlan {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosisId String   @unique
  diagnosis   Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)
  content     Json     // 结构化预案（诊断结论/紧急处置/绿色用药/免疫/生物安全/监测/回访要点）
  status      PreventionStatus @default(active)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  followUps FollowUp[]

  @@index([userId, createdAt])
  @@map("prevention_plans")
}

model FollowUp {
  id          String   @id @default(uuid())
  planId      String
  plan        PreventionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOffset   Int      // 3 或 7 日回访
  status      FollowUpStatus @default(pending)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([planId, createdAt])
  @@map("follow_ups")
}

model Immunization {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  houseId        String?
  house          PoultryHouse?      @relation(fields: [houseId], references: [id], onDelete: SetNull)
  batchId        String?
  batch          Batch?             @relation(fields: [batchId], references: [id], onDelete: SetNull)
  vaccineName    String             // 疫苗名称
  disease        String?            // 预防疾病
  method         ImmunizationMethod @default(injection)
  dosage         String?            // 剂量
  immunizedCount Int                @default(0)
  administeredAt DateTime?          // 实际免疫日期
  nextDueAt      DateTime?          // 下次应免疫日期（到期提醒）
  operator       String?            // 操作人/兽医
  vaccineBatch   String?            // 疫苗批号
  manufacturer   String?            // 生产厂家
  status         ImmunizationStatus @default(planned)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId, status, nextDueAt])
  @@map("immunizations")
}

model Product {
  id           String   @id @default(uuid())
  merchantId   String?  // 商家归属（null=平台自营种子商品）
  merchant     User?    @relation("MerchantProducts", fields: [merchantId], references: [id], onDelete: Cascade)
  name         String
  category     String
  price        Float
  promoPrice   Float?   // 促销价
  stock        Int      @default(0)
  sales        Int      @default(0) // 销量
  unit         String
  description  String?
  image        String?
  manufacturer String?
  createdAt    DateTime @default(now())

  @@index([merchantId])
  @@map("products")
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       Json        // [{productId, name, price, quantity}]
  totalAmount Float
  status      OrderStatus @default(pending)
  address     String?
  phone       String?
  merchantId   String?    // 履约商家（下单时按商品归属确定）
  referralVetId String?   // 兽医佣金推荐人
  commissionAmount Float? // 佣金金额
  logistics    Json?      // 物流轨迹 [{status, desc, time}]
  createdAt   DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([merchantId, createdAt])
  @@map("orders")
}

model ServiceOrder {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType   ServiceType
  description   String?
  address       String?
  appointmentAt DateTime?
  status        ServiceOrderStatus @default(pending)
  vetId         String?
  price         Float?
  createdAt     DateTime          @default(now())

  @@index([userId, createdAt])
  @@map("service_orders")
}

model Consultation {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vetId     String?
  subject   String
  messages  Json               // [{role, content, timestamp}]
  status    ConsultationStatus @default(active)
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@map("consultations")
}

model ConsultSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("AI 问诊")
  messages  Json     // 对话历史 chat_history：[{role, content, imageUrls, diagnosis, createdAt}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("consult_sessions")
}

model BulkPurchase {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  items       Json               // [{name, spec, quantity, requirement}]
  deadline    DateTime?
  status      BulkPurchaseStatus @default(open)
  winnerBidId String?
  createdAt   DateTime           @default(now())

  bids        Bid[]

  @@index([userId, createdAt])
  @@map("bulk_purchases")
}

model Bid {
  id             String       @id @default(uuid())
  bulkPurchaseId String
  bulkPurchase   BulkPurchase @relation(fields: [bulkPurchaseId], references: [id], onDelete: Cascade)
  merchantId     String
  merchant       User         @relation("MerchantBids", fields: [merchantId], references: [id], onDelete: Cascade)
  price          Float
  paymentTerms   String?      // 账期
  deliveryTime   String?      // 配送时间
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([bulkPurchaseId])
  @@index([merchantId])
  @@map("bids")
}

model Question {
  id          String       @id @default(uuid())
  type        QuestionType
  chapter     String?
  difficulty  Difficulty   @default(medium)
  question    String
  options     String       // JSON 数组
  answer      String       // JSON 数组（正确选项下标）
  explanation String?
  createdAt   DateTime     @default(now())

  @@map("questions")
}

model ExamRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ExamType @default(practice)
  chapter    String?
  totalScore Int
  score      Int
  answers    String   // JSON
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("exam_records")
}

model InternLog {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  content          String
  images           String?         // JSON 数组（图片 URL）
  studentDiagnosis String?
  mentorComment    String?
  mentorId         String?
  status           InternLogStatus @default(submitted)
  logDate          DateTime
  createdAt        DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([status, logDate])
  @@map("intern_logs")
}

model Certification {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         CertificationType
  data         Json                // 认证表单字段（按类型）
  images       String[]            @default([]) // 资质证件图片 URL
  status       CertificationStatus @default(pending)
  reviewerNote String?
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@map("certifications")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  content   String
  data      Json?            // 关联跳转信息（如 { diagnosisId, orderId }）
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model Policy {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  category  PolicyCategory @default(notice)
  content   String
  audience  Json           // 定向推送目标角色数组（空数组=全体角色）
  status    PolicyStatus   @default(published)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  reads PolicyRead[]

  @@index([status, createdAt])
  @@map("policies")
}

model PolicyRead {
  id       String   @id @default(uuid())
  policyId String
  policy   Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([policyId, userId])
  @@map("policy_reads")
}

model Annotation {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  imageUrl  String?
  symptoms  String[]         @default([])
  labels    String[]         @default([]) // 症状/病变标签
  disease   String           // 疾病分类
  note      String?
  status    AnnotationStatus @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, status, createdAt])
  @@map("annotations")
}

model Collaboration {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("CollabOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  topic       String?
  members     Json     // 成员列表 [{userId, name, role}]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages CollabMessage[]

  @@index([ownerId, createdAt])
  @@map("collaborations")
}

model CollabMessage {
  id             String       @id @default(uuid())
  collaborationId String
  collaboration  Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("CollabMessageUser", fields: [userId], references: [id], onDelete: Cascade)
  type           String       @default("text") // text | file
  content        String
  fileUrl        String?
  createdAt      DateTime     @default(now())

  @@index([collaborationId, createdAt])
  @@map("collab_messages")
}

model Customer {
  id             String        @id @default(uuid())
  ownerId        String
  owner          User          @relation("CustomerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  farmName       String?
  species        String?
  scale          Int?
  address        String?
  level          CustomerLevel @default(regular)
  notes          String?
  tags           String[]      @default([])
  nextFollowUpAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([ownerId, level, createdAt])
  @@map("customers")
}

model EpidemicAlert {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  disease   String
  level     EpidemicAlertLevel @default(general)
  province  String?
  city      String?
  district  String?
  content   String
  audience  Json               // 定向推送角色数组（空=全体角色）
  status    EpidemicAlertStatus @default(active)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status, createdAt])
  @@map("epidemic_alerts")
}

model Epidemiology {
  id                String             @id @default(uuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  disease           String
  province          String?
  city              String?
  district          String?
  source            String?            // 传染源（引种/人员/车辆/野鸟等）
  transmissionChain String?            // 传播链描述
  zones             Json?              // { point, infectedArea, threatenedArea }
  measures          String[]           @default([]) // 处置措施
  status            EpidemiologyStatus @default(investigating)
  conclusion        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId, status, createdAt])
  @@map("epidemiologies")
}

model Course {
  id          String       @id @default(uuid())
  teacherId   String
  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  subject     String?
  description String?
  chapters    Json         // [{ title, content }]
  status      CourseStatus @default(published)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  progresses CourseProgress[]

  @@index([teacherId, status, createdAt])
  @@map("courses")
}

model CourseProgress {
  id                String   @id @default(uuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation("StudentProgress", fields: [userId], references: [id], onDelete: Cascade)
  progress          Int      @default(0) // 0-100
  completedChapters Int[]    @default([]) // 已完成章节下标
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([courseId, userId])
  @@map("course_progresses")
}

model ExamPaper {
  id            String          @id @default(uuid())
  teacherId     String
  teacher       User            @relation("TeacherPapers", fields: [teacherId], references: [id], onDelete: Cascade)
  title         String
  chapter       String?         // 章节范围
  description   String?
  questionIds   Json            // 题目 id 数组
  totalScore    Int             @default(100)
  questionCount Int             @default(0)
  duration      Int?            // 考试时长（分钟）
  status        ExamPaperStatus @default(published)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([teacherId, status, createdAt])
  @@map("exam_papers")
}

enum Role {
  admin
  farmer
  vet
  technician
  merchant
  institution
  student
}

enum Species {
  chicken
  duck
  goose
  turkey
  other
}

enum Ventilation {
  good
  moderate
  poor
}

enum DiagnosisStatus {
  pending
  analyzing
  completed
  failed
}

enum BatchStatus {
  active
  completed
  archived
}

enum PreventionStatus {
  active
  completed
  archived
}

enum FollowUpStatus {
  pending
  completed
}

enum AlertType {
  temperature
  humidity
  ammonia
  co2
  disease
}

enum Severity {
  warning
  critical
}

enum EnvironmentCategory {
  air
  water
  feed
  surface
}

enum EnvironmentResult {
  normal
  warning
  abnormal
}

enum EpidemicLevel {
  suspected
  confirmed
  controlled
}

enum OrderStatus {
  pending
  paid
  shipped
  completed
  cancelled
}

enum ServiceType {
  on_site
  online
  lab_test
}

enum ServiceOrderStatus {
  pending
  accepted
  in_progress
  completed
  cancelled
}

enum ConsultationStatus {
  active
  closed
}

enum BulkPurchaseStatus {
  open
  awarded
  completed
  cancelled
}

enum QuestionType {
  single
  multiple
  judge
}

enum Difficulty {
  easy
  medium
  hard
}

enum ExamType {
  practice
  mock
}

enum InternLogStatus {
  submitted
  reviewed
}

enum CertificationType {
  farmer
  vet
  merchant
  institution
  student
}

enum CertificationStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  warning
  diagnosis
  policy
  order
  teaching
  system
}

enum PolicyCategory {
  prevention_plan
  immunization
  medication
  notice
  other
}

enum PolicyStatus {
  draft
  published
  archived
}

enum AnnotationStatus {
  pending
  verified
  special
}

enum CustomerLevel {
  vip
  regular
  potential
}

enum ImmunizationMethod {
  injection
  water
  drop_eye
  drop_nose
  spray
  other
}

enum ImmunizationStatus {
  planned
  completed
  overdue
}

enum EpidemicAlertLevel {
  general
  major
  severe
}

enum EpidemicAlertStatus {
  active
  resolved
}

enum EpidemiologyStatus {
  investigating
  processing
  completed
}

enum CourseStatus {
  draft
  published
}

enum ExamPaperStatus {
  draft
  published
  archived
}
