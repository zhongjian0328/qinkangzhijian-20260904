{
  "expo": {
    "name": "禽康智检",
    "slug": "qkzj-new",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "qinkangzhijian",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#155E75"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qinkangzhijian.app",
      "infoPlist": {
        "NSCameraUsageDescription": "需要访问相机以拍摄禽类照片进行AI诊断",
        "NSPhotoLibraryUsageDescription": "需要访问相册以选择禽类照片进行AI诊断"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#155E75"
      },
      "package": "com.qinkangzhijian.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以选择禽类照片"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许使用相机拍摄禽类照片"
        }
      ],
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "361f85fe-50b4-4b8a-8db0-5f91b6f50cee"
      }
    },
    "owner": "zhongjian475"
  }
}
